# https://clangd.llvm.org/config
#
# The fork's Linux clangd-tidy CI job builds Godot without this module (it is
# opt-in via physx_sdk=), so there is no compilation database entry for these
# files and clangd cannot resolve the PhysX SDK headers -- every file then
# reports as unparsable and fails the check. Suppress diagnostics for the module
# here; the real lint pass is `clang-tidy -p compile_commands.json` against an
# actual module build (scons ... physx_sdk=... compiledb=yes).

Diagnostics:
  Suppress: "*"
