 #include "foundation/PxThread.h"
 
 #include <math.h>
-#if !PX_APPLE_FAMILY && !defined(__CYGWIN__) && !PX_EMSCRIPTEN
+#if !PX_APPLE_FAMILY && !defined(__CYGWIN__) && !PX_EMSCRIPTEN && !defined(__ANDROID__)
 #include <bits/local_lim.h> // PTHREAD_STACK_MIN
 #endif
 #include <stdio.h>
@@ -244,8 +244,12 @@ __attribute__((noreturn))
 
 void PxThreadImpl::kill()
 {
+	// Android's bionic has no pthread_cancel: the thread is left to finish on its own (the CPU dispatcher's workers
+	// are told to quit and joined before they are destroyed, so this only matters for a thread still running then).
+#if !defined(__ANDROID__)
 	if(getThread(this)->state == ePxThreadStarted)
 		pthread_cancel(getThread(this)->thread);
+#endif
 	getThread(this)->state = ePxThreadStopped;
 }
 
