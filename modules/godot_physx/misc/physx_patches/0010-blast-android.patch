+#if !COMPILE_VECTOR_INTRINSICS
+// Scalar math (ARM: no SIMD path here): Vec3V and Vec4V are different types, so the transposes below don't compile.
+// The same packing, four points into x / y / z rows, element by element.
+static void _arrayVec3ToVec4(const NvVec3* src, const NvVec3& scale, Vec4V* dst, uint32_t num)
+{
+    for (uint32_t i = 0; i < num; i += 4, dst += 3)
+    {
+        NvVec3 p[4];
+        for (uint32_t j = 0; j < 4; j++)
+        {
+            const NvVec3& s = src[i + j < num ? i + j : num - 1];
+            p[j] = NvVec3(s.x * scale.x, s.y * scale.y, s.z * scale.z);
+        }
+        dst[0] = V4LoadXYZW(p[0].x, p[1].x, p[2].x, p[3].x);
+        dst[1] = V4LoadXYZW(p[0].y, p[1].y, p[2].y, p[3].y);
+        dst[2] = V4LoadXYZW(p[0].z, p[1].z, p[2].z, p[3].z);
+    }
+}
+
+static void _arrayVec3ToVec4(const NvVec3* src, Vec4V* dst, uint32_t num)
+{
+    _arrayVec3ToVec4(src, NvVec3(1.0f), dst, num);
+}
+
+static void _arrayVec3ToVec4(const NvVec3* src, const Vec3V& scale, Vec4V* dst, uint32_t num)
+{
+    NvVec3 s;
+    V3StoreU(scale, s);
+    _arrayVec3ToVec4(src, s, dst, num);
+}
+#else
 static void _arrayVec3ToVec4(const NvVec3* src, Vec4V* dst, uint32_t num)
 {
     const uint32_t num4 = num >> 2;
@@ -937,6 +968,7 @@ static void _arrayVec3ToVec4(const NvVec3* src, const Vec3V& scale, Vec4V* dst,
         dst[2] = work[2];
